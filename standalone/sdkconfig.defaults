# 대상: ESP32 (ESP32-WROOM-32, 플래시 4MB, PSRAM 없음)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 블루투스 클래식 + HFP 핸즈프리(클라이언트)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
# 폰 역할(오디오 게이트웨이)은 쓰지 않는다 — 기본값 y 를 끄면 RAM·플래시가 준다
CONFIG_BT_HFP_AG_ENABLE=n

# 통화 음성을 HCI 로 받아 앱에서 처리 — 컨트롤러와 Bluedroid 양쪽 모두
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
# 내장 코덱 경로는 IDF 에서 제거 예정 — 앱이 음성 프레임을 직접 다루는 새 API 를 쓴다
CONFIG_BT_HFP_USE_EXTERNAL_CODEC=y
# 1차는 CVSD(8kHz)만
CONFIG_BT_HFP_WBS_ENABLE=n

# Wi-Fi 와 블루투스가 무선 하나를 나눠 쓴다: 공존 켜기, 태스크를 서로 다른 코어에
# (블루투스 컨트롤러·Bluedroid 는 기본값 코어 0)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y

# AI 서버(api.openai.com)는 내장한 Google Trust Services 루트(main/google_roots.pem)로 확인한다 — 기본 번들은 쓰지 않는다
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# PSRAM 이 없으니 TLS 버퍼는 필요할 때만 잡는다
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# PSRAM 이 없으니 Wi-Fi 정적 수신 버퍼를 줄인다. 묶음 수신(AMPDU) 창은 기본값 6 그대로 —
# 창을 12 로 늘리거나 TCP 수신 창을 3배로 늘린 빌드는 통화 중 전송이 아예 멈췄다
# (블루투스 통화가 무선을 끊어 쓰는 사이에 큰 묶음이 통째로 깨지는 것으로 보인다).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# 통화 중에는 블루투스 때문에 Wi-Fi 패킷이 자주 사라진다 → TCP 가 빨리, 필요한 것만 다시 보내게
# - SACK: 서버가 빠진 조각만 다시 보낸다 (AI 음성 쪽)
# - 타이머 250 → 100ms: 우리가 보낸 조각을 더 빨리 다시 보낸다 (상대 음성 쪽, IDF 도움말: 나쁜 망에서 권장)
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_TMR_INTERVAL=100

# TLS 핸드셰이크(통화 중 약 4초)와 음성 처리를 빠르게
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# WebSocket 송수신은 한 잠금으로 직렬화한다 (기본값). 하나의 TLS 연결을 두 태스크가
# 동시에 읽고 쓰면 안전하지 않다 — SEPARATE_TX_LOCK 을 켰을 때 송신이 막혀 연결이 끊겼다.
